  "instrumentationSource": "function installProbe() {\n  const methods = [\n    [SVGGeometryElement.prototype, 'getTotalLength'],\n    [SVGGeometryElement.prototype, 'getPointAtLength'],\n    [SVGGraphicsElement.prototype, 'getCTM']\n  ];\n  const state = {active: false, calls: {}, raf: []};\n  for (const [prototype, method] of methods) {\n    const original = prototype[method];\n    prototype[method] = function (...args) {\n      if (!state.active) return Reflect.apply(original, this, args);\n      const start = performance.now();\n      try {return Reflect.apply(original, this, args);}\n      finally {\n        const elapsed = performance.now() - start;\n        const key = `${method}|${this.id || this.getAttribute('class') || this.tagName}`;\n        const entry = state.calls[key] ||= {count: 0, totalMs: 0, maxMs: 0};\n        entry.count++; entry.totalMs += elapsed; entry.maxMs = Math.max(entry.maxMs, elapsed);\n      }\n    };\n  }\n  const nativeRAF = window.requestAnimationFrame.bind(window);\n  window.requestAnimationFrame = callback => nativeRAF(function (timestamp) {\n    if (callback.name !== 'loop' || !state.active) return callback(timestamp);\n    const start = performance.now();\n    try {return callback(timestamp);}\n    finally {state.raf.push(performance.now() - start);}\n  });\n  window.__markerProbe = {\n    start() {state.calls = {}; state.raf = []; state.active = true;},\n    stop() {state.active = false; return {calls: state.calls, raf: state.raf};}\n  };\n}\n",
